# ============================================================
# Libe Aios — Environment Variables Reference
# Copy this file to .env.local and fill in your values
# ============================================================

# Database
DATABASE_URL=postgresql://libe:libepass@localhost:5434/libe_aios
POSTGRES_PASSWORD=libepass

# Better Auth
BETTER_AUTH_SECRET=your_super_secret_key_min_32_chars
BETTER_AUTH_URL=http://localhost:3000

# MinIO / S3 File Storage
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=libe-aios
MINIO_PUBLIC_URL=http://127.0.0.1:9000/libe-aios

# GitHub App Integration (optional, for webhooks)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=

# Jira Integration
JIRA_WEBHOOK_SECRET=

# Production Only
NEXT_PUBLIC_MINIO_ENDPOINT=127.0.0.1:9000

# Telegram Daily Standup Bot (src/app/api/cron/telegram-daily-standup)
# - TOKEN: từ @BotFather khi tạo bot
# - CHAT_ID: id của group (số âm, lấy từ /getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
