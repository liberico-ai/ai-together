    15	export function outboxTransition(state:OutboxState,signal:OutboxSignal,attemptNo:number):OutboxState {
    16	 const next=((): OutboxState|undefined=>{
    17	  switch(state) {
    18	   case 'pending': return signal==='lease'?'leased':undefined;
    19	   case 'leased':
    20	    if(signal==='delivered') return 'delivered';
    21	    if(signal==='failed_retryable') return attemptNo<MAX_ATTEMPTS?'pending':'dead';
    22	    if(signal==='failed_permanent') return 'dead';
    23	    if(signal==='uncertain'||signal==='lease_expired') return 'uncertain';
    24	    return undefined;
    25	   case 'uncertain':
    26	    if(signal==='reconciled_delivered') return 'delivered';
    27	    if(signal==='reconciled_not_sent') return attemptNo<MAX_ATTEMPTS?'pending':'dead';
    28	    if(signal==='abandon') return 'abandoned';
    29	    return undefined;
