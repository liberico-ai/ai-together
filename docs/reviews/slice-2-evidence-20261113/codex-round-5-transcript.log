    18	  -- A registration ballot names a registration and no subject; an access-change ballot names a subject, its version and frozen grants.
    19	  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_constraint WHERE conname='account_approvals_kind_shape' AND conrelid='identity.account_approvals'::regclass) THEN
