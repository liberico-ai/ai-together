   307	      RAISE EXCEPTION 'Outbox delivered_at and telegram_message_id change only on a move to delivered';
   308	    END IF;
   309	    IF NEW.attempt_no IS DISTINCT FROM OLD.attempt_no OR NEW.next_attempt_at IS DISTINCT FROM OLD.next_attempt_at
   310	       OR NEW.lease_token IS DISTINCT FROM OLD.lease_token OR NEW.lease_expires_at IS DISTINCT FROM OLD.lease_expires_at
   311	       OR NEW.last_error_code IS DISTINCT FROM OLD.last_error_code THEN
   312	      RAISE EXCEPTION 'Outbox attempt_no, next_attempt_at, lease_token, lease_expires_at and last_error_code change only with a state move';
   313	    END IF;
   314	    IF NEW.failure_owner_id IS DISTINCT FROM OLD.failure_owner_id
   315	       AND NOT (current_user = 'libetech_runtime' AND NEW.version = OLD.version + 1) THEN
   316	      RAISE EXCEPTION 'Outbox failure_owner_id changes only when libetech_runtime takes the row, with version raised by exactly 1';
   317	    END IF;
   318	    IF NEW.version IS DISTINCT FROM OLD.version
   319	       AND NOT (current_user = 'libetech_runtime' AND NEW.failure_owner_id IS DISTINCT FROM OLD.failure_owner_id AND NEW.version = OLD.version + 1) THEN
   320	      RAISE EXCEPTION 'Outbox version stays while the state stays; only a libetech_runtime take raises it, by exactly 1';
