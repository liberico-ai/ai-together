   264	-- raised by exactly 1: the «take» command (src/server/inbox.ts), which writes its own intake_events row 'outbox.taken'.
   265	-- The version stays while the state stays (Codex review, concern 4 ruling): that take is the only same-state update that raises it.
   266	-- A bare version bump, or one that comes with only updated_at or acknowledged_at, raises for every role; it would move the expected
   267	-- version with no state event and no intake_events row.
   268	-- delivered_at and telegram_message_id move only with a move to delivered; delivered and abandoned rows are frozen except
   269	-- acknowledged_at and updated_at; acknowledged_at is set once, from NULL to a value, in any state, and is never changed or
   270	-- cleared afterwards. Recipient-acknowledged is its own state, separate from delivered: a vote never sets delivered_at, and only
   271	-- libetech_identity on DM rows may set acknowledged_at (grants and RLS below); that update keeps the version.
   272	-- Runs with the caller's rights on every row update, so it also records current_user (the invoking role) for the state trigger below,
   273	-- which runs as its owner and must not take the caller's word for who it is.
   274	CREATE OR REPLACE FUNCTION outbox_messages_guard_state() RETURNS trigger LANGUAGE plpgsql SET search_path = pg_catalog, public, pg_temp AS $$
   275	BEGIN
   276	  PERFORM pg_catalog.set_config('app.outbox_invoker', current_user::text, true);
   277	  -- a state change raises the version by exactly 1; a same-state update keeps it, except a runtime take (checked at the end of the ELSE branch).
   278	  IF NEW.state IS DISTINCT FROM OLD.state THEN
   279	    IF NEW.version IS DISTINCT FROM OLD.version + 1 THEN RAISE EXCEPTION 'Outbox state change must raise version by exactly 1'; END IF;
   280	    IF NOT ((OLD.state = 'pending' AND NEW.state = 'leased')
   281	         OR (OLD.state = 'leased' AND NEW.state IN ('delivered','pending','dead','uncertain'))
   282	         OR (OLD.state = 'uncertain' AND NEW.state IN ('delivered','pending','dead','abandoned'))
   283	         OR (OLD.state = 'dead' AND NEW.state IN ('pending','abandoned'))) THEN
   284	      RAISE EXCEPTION 'Outbox state move % to % is not allowed', OLD.state, NEW.state;
   285	    END IF;
   286	    IF current_user = 'libetech_runtime' THEN
   287	      IF NOT ((OLD.state = 'dead' AND NEW.state = 'pending' AND NEW.attempt_no = 0)
   288	           OR (OLD.state IN ('dead','uncertain') AND NEW.state = 'abandoned')) THEN
   289	        RAISE EXCEPTION 'Outbox state move % to % is not allowed for the runtime role', OLD.state, NEW.state;
   290	      END IF;
   291	      IF NEW.attempt_no IS DISTINCT FROM OLD.attempt_no AND NOT (NEW.state = 'pending' AND NEW.attempt_no = 0) THEN
   292	        RAISE EXCEPTION 'Runtime role may not change attempt_no here';
   293	      END IF;
   294	    END IF;
   295	    IF NEW.state <> 'delivered' AND (NEW.delivered_at IS DISTINCT FROM OLD.delivered_at OR NEW.telegram_message_id IS DISTINCT FROM OLD.telegram_message_id) THEN
   296	      RAISE EXCEPTION 'Outbox delivered_at and telegram_message_id change only on a move to delivered';
   297	    END IF;
   298	  ELSE
   299	    IF OLD.state IN ('delivered','abandoned') AND (
   300	         NEW.attempt_no IS DISTINCT FROM OLD.attempt_no OR NEW.next_attempt_at IS DISTINCT FROM OLD.next_attempt_at
   301	      OR NEW.lease_token IS DISTINCT FROM OLD.lease_token OR NEW.lease_expires_at IS DISTINCT FROM OLD.lease_expires_at
   302	      OR NEW.delivered_at IS DISTINCT FROM OLD.delivered_at OR NEW.telegram_message_id IS DISTINCT FROM OLD.telegram_message_id
   303	      OR NEW.last_error_code IS DISTINCT FROM OLD.last_error_code OR NEW.failure_owner_id IS DISTINCT FROM OLD.failure_owner_id) THEN
   304	      RAISE EXCEPTION 'Outbox terminal row (%) is frozen', OLD.state;
