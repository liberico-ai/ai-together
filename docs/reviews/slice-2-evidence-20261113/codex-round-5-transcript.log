   329	DROP TRIGGER IF EXISTS outbox_messages_guard_state ON outbox_messages;
   330	CREATE TRIGGER outbox_messages_guard_state BEFORE UPDATE ON outbox_messages FOR EACH ROW EXECUTE FUNCTION outbox_messages_guard_state();
