    10	export type OutboxState='pending'|'leased'|'delivered'|'uncertain'|'dead'|'abandoned';
    11	export type OutboxSignal='lease'|'delivered'|'failed_retryable'|'failed_permanent'|'uncertain'|'lease_expired'|'reconciled_delivered'|'reconciled_not_sent'|'requeue'|'abandon';
