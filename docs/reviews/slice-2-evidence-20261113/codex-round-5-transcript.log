   332	-- Proof by privilege: only libetech_outbox_audit holds INSERT on outbox_state_events, and the only code that runs as it is the state
   333	-- trigger below, which builds every column of the row from OLD/NEW of the outbox row it fires on. The row therefore needs no lookup of
   334	-- the live outbox row (tenant, project, to_state, attempt_no and version are NEW's). This check keeps the closed signal/move table and the
   335	-- runtime limit. Not SECURITY DEFINER: as an invoker trigger it sees the inserting role as current_user.
   336	CREATE OR REPLACE FUNCTION outbox_state_events_validate() RETURNS trigger LANGUAGE plpgsql SET search_path = pg_catalog, public, pg_temp AS $$
   337	BEGIN
   338	  IF current_user <> 'libetech_outbox_audit' THEN RAISE EXCEPTION 'State events are written only by the outbox state trigger'; END IF;
   339	  -- The state trigger runs as the audit role for any login; a login that can itself SET ROLE to it is the one that must not insert.
   340	  IF NOT coalesce((SELECT rolsuper FROM pg_catalog.pg_roles WHERE rolname = session_user), false)
   341	     AND pg_catalog.pg_has_role(session_user, 'libetech_outbox_audit', 'MEMBER') THEN
   342	    RAISE EXCEPTION 'State events are not written by a login that is a member of libetech_outbox_audit';
   343	  END IF;
   344	  IF NOT ((NEW.from_state = 'pending' AND NEW.to_state = 'leased')
   345	       OR (NEW.from_state = 'leased' AND NEW.to_state IN ('delivered','pending','dead','uncertain'))
   346	       OR (NEW.from_state = 'uncertain' AND NEW.to_state IN ('delivered','pending','dead','abandoned'))
   347	       OR (NEW.from_state = 'dead' AND NEW.to_state IN ('pending','abandoned'))) THEN
   348	    RAISE EXCEPTION 'State event move % to % is not an allowed move', NEW.from_state, NEW.to_state;
   349	  END IF;
   350	  IF NOT ((NEW.signal = 'lease' AND NEW.from_state = 'pending' AND NEW.to_state = 'leased')
   351	       OR (NEW.signal = 'delivered' AND NEW.from_state = 'leased' AND NEW.to_state = 'delivered')
   352	       OR (NEW.signal = 'failed_retryable' AND NEW.from_state = 'leased' AND NEW.to_state IN ('pending','dead'))
   353	       OR (NEW.signal = 'failed_permanent' AND NEW.from_state = 'leased' AND NEW.to_state = 'dead')
   354	       OR (NEW.signal IN ('uncertain','lease_expired') AND NEW.from_state = 'leased' AND NEW.to_state = 'uncertain')
   355	       OR (NEW.signal = 'reconciled_delivered' AND NEW.from_state = 'uncertain' AND NEW.to_state = 'delivered')
   356	       OR (NEW.signal = 'reconciled_not_sent' AND NEW.from_state = 'uncertain' AND NEW.to_state IN ('pending','dead'))
   357	       OR (NEW.signal = 'requeue' AND NEW.from_state = 'dead' AND NEW.to_state = 'pending')
   358	       OR (NEW.signal = 'abandon' AND NEW.from_state IN ('dead','uncertain') AND NEW.to_state = 'abandoned')) THEN
   359	    RAISE EXCEPTION 'State event signal % does not belong to the move % to %', NEW.signal, NEW.from_state, NEW.to_state;
   360	  END IF;
