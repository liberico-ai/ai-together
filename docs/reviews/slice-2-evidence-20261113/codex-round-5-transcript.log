    21	      (kind='registration' AND registration_id IS NOT NULL AND subject_user_id IS NULL)
    22	      OR (kind='access_change' AND registration_id IS NULL AND subject_user_id IS NOT NULL
    23	          AND subject_account_version IS NOT NULL AND previous_grants IS NOT NULL));
