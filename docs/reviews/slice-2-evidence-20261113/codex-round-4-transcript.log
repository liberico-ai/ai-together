   227	 async sources(p:Principal,projectId:string):Promise<SourceAvailabilityRow[]> {
   228	  readable(p,projectId);
   229	  return this.run(p,projectId,async tx=>{
   230	   // project_channels is read to show what was proposed; it never decides what is received (OQ-09).
   231	   const channels=(await tx.query<{chat_id:string;topic_id:string}>('SELECT chat_id,topic_id FROM project_channels WHERE project_id=$1 ORDER BY created_at,id LIMIT 200',[projectId])).rows;
   232	   const out:SourceAvailabilityRow[]=[];
   233	   for(const ch of channels) {
   234	    const match='project_id=$1 AND chat_id=$2 AND ($3=\'\' OR topic_id=$3)';
   235	    const first=(await tx.query<{first:unknown}>(`SELECT min(observed_at) AS first FROM source_events WHERE ${match}`,[projectId,ch.chat_id,ch.topic_id])).rows[0].first;
   236	    if(first==null) {out.push({chatId:ch.chat_id,topicId:ch.topic_id,state:'not-configured',coverageStart:null,coverageGaps:[],label:'Chưa xác minh khả năng nhận tin'});continue;}
   237	    const gaps=(await tx.query<{observed_at:unknown;ingested_at:unknown}>(`SELECT observed_at,ingested_at FROM source_events WHERE ${match} AND spooled ORDER BY observed_at LIMIT 100`,[projectId,ch.chat_id,ch.topic_id])).rows;
   238	    const start=iso(first);
   239	    out.push({chatId:ch.chat_id,topicId:ch.topic_id,state:'partially-received',coverageStart:start,coverageGaps:gaps.map(g=>({from:iso(g.observed_at),to:iso(g.ingested_at)})),
   240	     // the instant is coverageStart; the screen formats it, so no raw ISO reaches the label (UI-4)
   241	     label:'Nhận từ mốc ghi đầu tiên; không có lịch sử trước mốc này'});
   242	   }
   243	   return out;
   244	  });
   245	 }
