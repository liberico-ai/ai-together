   247	 async failures(p:Principal,projectId:string):Promise<FailureRow[]> {
   248	  readable(p,projectId);
   249	  return this.run(p,projectId,async tx=>(await tx.query<{id:string;state:FailureRow['state'];template:string;candidate_id:string|null;last_error_code:string|null;failure_owner_id:string|null;version:number;overdue:boolean}>(
   250	   `SELECT id,state,template,candidate_id,last_error_code,failure_owner_id,version,
   251	      (state='leased' OR (delivered_at IS NULL AND created_at < now() - make_interval(secs => $2::double precision))) AS overdue
   252	    FROM outbox_messages
   253	    WHERE project_id=$1 AND (state IN ('dead','uncertain')
   254	      OR (state='pending' AND created_at < now() - make_interval(secs => $2::double precision))
   255	      OR (state='leased' AND lease_expires_at < now()))
   256	    ORDER BY created_at,id LIMIT 200`,[projectId,OVERDUE_SECONDS])).rows
   257	   .map(r=>({outboxId:r.id,state:r.state,template:r.template,candidateRef:r.candidate_id?refOf(r.candidate_id):null,lastErrorCode:r.last_error_code,ownerId:r.failure_owner_id,overdue:r.overdue,version:r.version})));
   258	 }
