   114	 /** One scoped transaction on a single project, with the acting person set for the database (event actor, state-event actor). */
   115	 private run<T>(p:Principal,projectId:string,fn:(tx:Queryable)=>Promise<T>):Promise<T> {
   116	  return scoped(this.db,{...p,projectIds:[projectId]},async tx=>{
   117	   await tx.query("SELECT set_config('app.person_id',$1,true)",[p.id]);
   118	   return fn(tx);
   119	  });
   120	 }
   121	 /** Finds which project an id belongs to among the projects this person is scoped to. Missing and out of scope look the same. */
   122	 private async locate(p:Principal,table:'intake_candidates'|'outbox_messages',id:string):Promise<string> {
   123	  if(!p||p.role==='bot'||!p.projectIds?.length||!uuid.safeParse(id).success) throw DENIED();
   124	  const row=await scoped(this.db,p,async tx=>(await tx.query<{project_id:string}>(`SELECT project_id FROM ${table} WHERE id=$1`,[id])).rows[0]);
   125	  if(!row?.project_id) throw DENIED();
   126	  return row.project_id;
   127	 }
