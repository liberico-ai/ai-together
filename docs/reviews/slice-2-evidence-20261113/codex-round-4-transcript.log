   223	-- A receipt's project is derived from its outbox row, not trusted from the caller. Not SECURITY DEFINER: RLS on outbox_messages
   224	-- applies to the inserting role, so an invisible outbox row raises. A NULL derived project cannot reach the DM branch of the policy.
   225	-- Every trigger function pins search_path and schema-qualifies its tables so a TEMP shadow table cannot take their place.
   226	CREATE OR REPLACE FUNCTION delivery_receipts_derive_project() RETURNS trigger LANGUAGE plpgsql SET search_path = pg_catalog, public, pg_temp AS $$
   227	DECLARE found boolean; derived uuid;
   228	BEGIN
   229	  SELECT true, o.project_id INTO found, derived FROM public.outbox_messages o WHERE o.id = NEW.outbox_id AND o.tenant_id = NEW.tenant_id;
   230	  IF found IS NOT TRUE THEN RAISE EXCEPTION 'Receipt outbox row is not visible'; END IF;
   231	  IF NEW.project_id IS DISTINCT FROM derived THEN RAISE EXCEPTION 'Receipt project must equal the outbox row project'; END IF;
   232	  RETURN NEW;
   233	END $$;
   234	DROP TRIGGER IF EXISTS delivery_receipts_derive_project ON delivery_receipts;
   235	CREATE TRIGGER delivery_receipts_derive_project BEFORE INSERT ON delivery_receipts FOR EACH ROW EXECUTE FUNCTION delivery_receipts_derive_project();
   236	-- Target binding (not SECURITY DEFINER; the caller's RLS applies). project_channels grants no authority in this slice (OQ-09), so it is not read.
   237	-- A group row may only reply in the chat, topic and message of its own visible source event; a DM row only to the recipient's linked telegram id.
   238	CREATE OR REPLACE FUNCTION outbox_messages_bind_target() RETURNS trigger LANGUAGE plpgsql SET search_path = pg_catalog, public, pg_temp AS $$
   239	DECLARE s record; tg text;
   240	BEGIN
   241	  IF NEW.audience = 'group' THEN
   242	    IF NEW.source_event_id IS NULL THEN RAISE EXCEPTION 'Outbox target: a group row needs a source event'; END IF;
   243	    SELECT e.chat_id, e.topic_id, e.message_id INTO s FROM public.source_events e
   244	      WHERE e.id = NEW.source_event_id AND e.tenant_id = NEW.tenant_id AND e.project_id = NEW.project_id;
   245	    IF NOT FOUND THEN RAISE EXCEPTION 'Outbox target: source event is not visible'; END IF;

