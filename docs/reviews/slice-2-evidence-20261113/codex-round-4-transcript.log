    55	  forwarded boolean NOT NULL, addressed boolean NOT NULL, spooled boolean NOT NULL DEFAULT false,
    56	  -- OQ-30 (b), 14/11/2026: no content mode here; each revision carries its own (source_event_revisions.content_mode).
    57	  trace_id uuid NOT NULL, correlation_id uuid NOT NULL,
    58	  FOREIGN KEY(project_id,tenant_id) REFERENCES projects(id,tenant_id),
    59	  UNIQUE(tenant_id,source_type,chat_id,message_id),
    60	  UNIQUE(id,tenant_id,project_id)
    61	);
    62	CREATE TABLE IF NOT EXISTS source_event_revisions (
    63	  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
