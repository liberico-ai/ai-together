    44	CREATE TABLE IF NOT EXISTS source_events (
    45	  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    46	  tenant_id uuid NOT NULL, project_id uuid NOT NULL,
    47	  created_at timestamptz NOT NULL DEFAULT now(), updated_at timestamptz NOT NULL DEFAULT now(),
    48	  source_id text NOT NULL, source_type text NOT NULL CHECK(source_type='telegram_gateway'),
    49	  ingested_at timestamptz NOT NULL DEFAULT now(), quality_score smallint NOT NULL CHECK(quality_score BETWEEN 0 AND 100),
    50	  chat_id text NOT NULL CHECK(chat_id ~ '^-[1-9][0-9]*$'), topic_id text NOT NULL DEFAULT '',
    51	  message_id text NOT NULL CHECK(message_id ~ '^[1-9][0-9]*$'),
    52	  reply_to_message_id text, media_group_id text, thread_key text NOT NULL,
    53	  source_actor text NOT NULL, source_actor_label text NOT NULL DEFAULT '',
