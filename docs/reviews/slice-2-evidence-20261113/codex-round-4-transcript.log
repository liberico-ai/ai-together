   169	   const seats=await verifiedApprovalSeats(tx,this.identity);
   170	   invariant(seats.some(seat=>seat.user_id===p.id),'APPROVER_REQUIRED','Không có quyền duyệt tài khoản.',403);
   171	   const row=(await tx.query<Approval>(`SELECT ${APPROVAL_COLS}
   172	    FROM identity.account_approvals WHERE id=$1 FOR UPDATE`,[approvalId])).rows[0];
   173	   invariant(row,'APPROVAL_NOT_FOUND','Không tìm thấy phiếu duyệt.',404);
   174	   const voters=await frozenVoters(tx,this.identity,row,seats);
   175	   invariant(voters.some(v=>v.user_id===p.id),'APPROVER_REQUIRED','Không có quyền duyệt phiếu này.',403);
   176	   if(row.kind==='access_change'&&['pending','approved'].includes(row.state)) {
   177	    // The ballot froze the account at one version. If the account changed since, the card is stale: close the ballot, record no vote.
   178	    // Plain read (no lock): account commands lock the user before the ballot, so locking here would invert that order. A change that
   179	    // commits after this read is caught where it matters, in `access`, which requires the frozen version to equal the current one.
   180	    const subject=(await tx.query<{account_version:number}>(
   181	     'SELECT account_version FROM identity.users WHERE id=$1',[row.subject_user_id])).rows[0];
   182	    if(subject?.account_version!==row.subject_account_version) {
   183	     await tx.query(`UPDATE identity.account_approvals SET state='expired',updated_at=now() WHERE id=$1`,[approvalId]);
   184	     await tx.query(`INSERT INTO identity.events(tenant_id,user_id,actor_id,kind,detail)
   185	      VALUES($1,$2,$3,'access_change_expired',$4)`,[this.identity.tenantId,row.subject_user_id,p.id,
   186	       JSON.stringify({approvalId,reason:'account_changed',frozenVersion:row.subject_account_version,
   187	        accountVersion:subject?.account_version??null,previousState:row.state})]);
   188	     return {closed:true} as const;
   189	    }
   190	   }
   191	   const previous=(await tx.query<{choice:string}>(
   192	    'SELECT choice FROM identity.account_approval_votes WHERE approval_id=$1 AND voter_id=$2',[approvalId,p.id])).rows[0];
   193	   if(previous) {
   194	    invariant(previous.choice===decision,'VOTE_LOCKED','Phiếu đã ghi lựa chọn khác.',409);
   195	    return {approvalId,...await tallyFor(row.kind)(tx,approvalId,voters),state:row.state,replayed:true};
   196	   }
   197	   invariant(row.state==='pending'&&new Date(row.expires_at).getTime()>Date.now(),
   198	    'APPROVAL_CLOSED','Phiếu đã kết thúc hoặc hết hạn.',409);
   199	   await tx.query(`INSERT INTO identity.account_approval_votes(approval_id,tenant_id,voter_id,choice)
   200	    VALUES($1,$2,$3,$4)`,[approvalId,this.identity.tenantId,p.id,decision]);
   201	   // The voter acted on the ballot: their own DM is recipient-acknowledged. Delivery stays whatever the gateway reported;
   202	   // a ballot created before the DMs existed has no row, which is not an error.
   203	   await tx.query(`UPDATE outbox_messages SET acknowledged_at=now(),updated_at=now()
   204	    WHERE tenant_id=$1 AND dedupe_key=$2 AND acknowledged_at IS NULL`,[this.identity.tenantId,ballotDmKey(approvalId,p.id)]);
   205	   const result=await tallyFor(row.kind)(tx,approvalId,voters);
   206	   if(result.state!=='pending') await tx.query(`UPDATE identity.account_approvals SET state=$2,updated_at=now()
   207	    WHERE id=$1`,[approvalId,result.state]);
   208	   await tx.query(`INSERT INTO identity.events(tenant_id,actor_id,kind,detail)
   209	    VALUES($1,$2,'account_approval_vote',$3)`,[this.identity.tenantId,p.id,
   210	     JSON.stringify({approvalId,choice:decision,...result})]);
   211	   return {approvalId,...result,replayed:false};
   212	  });
   213	  // The expiry above is committed before the refusal, so a stale card closes the ballot for everyone.
   214	  invariant(!('closed' in outcome),'APPROVAL_CLOSED','Phiếu đã kết thúc hoặc hết hạn.',409);
   215	  return outcome;
   216	 }
   217	}
     1	import type { ProjectGrant } from './types';
     2	
     3	// Pure rule, shared by the server (AccountService) and the team screen, so the two cannot drift (code review m-2).
     4	/**
     5	 * A grant change widens access unless every grant after it is a pure reduction of a grant held before:
     6	 * same project, same role or down to viewer, and no report permission that was not held. Removing grants never widens.
     7	 * A widening needs an approved ballot; a reduction is applied directly.
     8	 */
     9	export function widensAccess(before: ProjectGrant[], after: ProjectGrant[]): boolean {
    10	  return !after.every(next => {
    11	    const prior = before.find(grant => grant.projectId === next.projectId);
    12	    return prior !== undefined && (next.role === prior.role || next.role === 'viewer')
    13	      && next.reportPermissions.every(permission => prior.reportPermissions.includes(permission));
    14	  });
    15	}

