   134	   const params:unknown[]=[q.projectId];
   135	   let filter='';
   136	   if(q.state) {params.push(q.state);filter=` AND c.state=$${params.length}`;}
   137	   const total=(await tx.query<{n:number}>(`SELECT count(*)::int AS n FROM intake_candidates c WHERE c.project_id=$1${filter}`,params)).rows[0].n;
   138	   params.push(q.limit,q.offset);
   139	   const rows=(await tx.query<CardRow>(`${CARD_SQL}${filter} ORDER BY c.created_at DESC,c.id LIMIT $${params.length-1} OFFSET $${params.length}`,params)).rows;
   140	   const allowed=await allowedFor(tx,q.projectId,this.excerptChats);
   141	   return {items:rows.map(r=>toCard(r,allowed)),total};
   142	  });
   143	 }
