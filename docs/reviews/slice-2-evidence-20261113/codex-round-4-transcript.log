    87	const pullSchema=z.object({limit:z.number().int().min(1).max(10)}).strict();
    88	const receiptSchema=z.object({
    89	 outboxId:z.string().uuid(),attemptNo:z.number().int().min(1),leaseToken:z.string().uuid(),phase:z.enum(['send','reconcile']),
    90	 outcome:z.enum(['delivered','failed_retryable','failed_permanent','uncertain','not_sent']),
