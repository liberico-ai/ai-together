   260	 async failureCommand(p:Principal,outboxId:string,raw:unknown,key:string,requestId:string):Promise<void> {
   261	  uuid.parse(requestId);
   262	  const projectId=await this.locate(p,'outbox_messages',outboxId);
   263	  managerOf(p,projectId);
   264	  const input=failureSchema.parse(raw);
   265	  await this.run(p,projectId,tx=>deduplicate(tx,p,projectId,key,{op:'inbox.outbox.'+input.kind,outboxId,...input},async()=>{
   266	   const row=(await tx.query<{id:string;tenant_id:string;project_id:string;state:OutboxState;attempt_no:number;version:number;trace_id:string;failure_owner_id:string|null}>(
   267	    'SELECT id,tenant_id,project_id,state,attempt_no,version,trace_id,failure_owner_id FROM outbox_messages WHERE id=$1 AND project_id=$2 FOR UPDATE',[outboxId,projectId])).rows[0];
   268	   if(!row) throw DENIED();
   269	   if(row.version!==input.expectedVersion) throw new AppError('REVISION_CONFLICT','Tin đã thay đổi; tải lại rồi thao tác lại.',409);
   270	   if(input.kind==='take') {
   271	    // Same state: not a transition, so it does not go through applyOutboxSignal.
   272	    if(row.state!=='dead'&&row.state!=='uncertain'&&row.state!=='pending') throw new AppError('OUTBOX_TRANSITION_INVALID','Không nhận xử lý được tin ở trạng thái này.',409);
   273	    // Already this person's: nothing to change. The guard keeps the version while the owner stays, so answer before any write.
   274	    if(row.failure_owner_id===p.id) throw new AppError('OUTBOX_ALREADY_TAKEN','Bạn đang nhận xử lý tin này.',409);
   275	    const upd=await tx.query('UPDATE outbox_messages SET failure_owner_id=$3,version=version+1,updated_at=now() WHERE id=$1 AND version=$2 RETURNING id',[outboxId,input.expectedVersion,p.id]);
   276	    if(!upd.rows.length) throw new AppError('REVISION_CONFLICT','Tin đã thay đổi; tải lại rồi thao tác lại.',409);
   277	   } else if(input.kind==='requeue') await applyOutboxSignal(tx,row,'requeue',{requestId},{set:{attempt_no:0}});
   278	   else await applyOutboxSignal(tx,row,'abandon',{requestId});
   279	   const kind={take:'outbox.taken',requeue:'outbox.requeued',abandon:'outbox.abandoned'}[input.kind];
   280	   await tx.query(
   281	    `INSERT INTO intake_events(tenant_id,project_id,entity_type,entity_id,actor_id,actor_kind,kind,request_id,trace_id,payload) VALUES($1,$2,'outbox_message',$3,$4,'user',$5,$6,$7,$8)`,
   282	    [p.tenantId,projectId,outboxId,p.id,kind,requestId,row.trace_id,JSON.stringify({stateBefore:row.state,versionBefore:row.version,reason:input.reason})]);
   283	   const stateAfter=input.kind==='requeue'?'pending':input.kind==='abandon'?'abandoned':row.state;
   284	   return {outboxId,state:stateAfter,version:row.version+1};
   285	  }));
   286	 }
   287	}

