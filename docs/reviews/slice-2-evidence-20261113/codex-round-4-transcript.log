    65	// "lat" = the newest revision of each candidate's root message, chosen by edited_at then revision_no (LATEST_REVISION_ORDER).
    66	const CARD_SQL=`WITH lat AS (
    67	  SELECT DISTINCT ON (c.id) c.id AS cid, r.content_hash, r.content_mode, r.text_excerpt
    68	  FROM intake_candidates c JOIN source_events e ON e.id=c.root_source_event_id JOIN source_event_revisions r ON r.source_event_id=e.id
