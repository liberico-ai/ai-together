   174	 /** requestId comes from the caller (the HTTP request id), never from JSON. */
   175	 async command(p:Principal,candidateId:string,raw:unknown,key:string,requestId:string):Promise<CandidateCard> {
   176	  uuid.parse(requestId);
   177	  const projectId=await this.locate(p,'intake_candidates',candidateId);
   178	  managerOf(p,projectId);
   179	  const input=commandSchema.parse(raw);
   180	  const action:CandidateAction=input.kind;
   181	  return this.run(p,projectId,async tx=>{
   182	   // The stored idempotent response holds ids, state and version only; the card is always re-read.
   183	   const done=await deduplicate(tx,p,projectId,key,{op:'inbox.candidate.'+input.kind,candidateId,...input},async()=>{
   184	   if(input.kind==='mark_duplicate') {
   185	    // Lock source and target in id order so two opposite marks serialize instead of forming a cycle.
   186	    await tx.query('SELECT id FROM intake_candidates WHERE id=ANY($1::uuid[]) AND project_id=$2 ORDER BY id FOR UPDATE',[[candidateId,input.duplicateOf],projectId]);
   187	   }
   188	   const row=(await tx.query<{id:string;state:CandidateState;version:number;classification:string|null;duplicate_of:string|null;missing_fields:string[];note:string;ticket_ref:string|null;trace_id:string}>(
   189	    `SELECT c.id,c.state,c.version,c.classification,c.duplicate_of,c.missing_fields,c.note,c.ticket_ref,e.trace_id
   190	     FROM intake_candidates c JOIN source_events e ON e.id=c.root_source_event_id WHERE c.id=$1 AND c.project_id=$2 FOR UPDATE OF c`,[candidateId,projectId])).rows[0];
   191	   if(!row) throw DENIED();
   192	   if(row.version!==input.expectedVersion) throw new AppError('REVISION_CONFLICT','Ứng viên đã thay đổi; tải lại rồi thao tác lại.',409);
   193	   const next=candidateTransition(row.state,action);
   194	   const set={classification:row.classification,duplicateOf:row.duplicate_of,missing:row.missing_fields,note:row.note,ticketRef:row.ticket_ref};
   195	   const detail:Record<string,unknown>={};
   196	   switch(input.kind) {
   197	    // The incident note is the manager's own text (impact / recovery); the event payload is what «Xem chi tiết» shows.
   198	    case 'confirm': set.classification=input.classification;set.duplicateOf=null;set.missing=[];set.note=input.note??'';detail.classification=input.classification;
   199	     if(input.note) detail.note=input.note;break;
   200	    case 'need_info': set.missing=input.missingFields;detail.missingFields=input.missingFields;break;
   201	    case 'mark_duplicate': {
   202	     if(input.duplicateOf===candidateId) throw new AppError('INVALID_DUPLICATE_TARGET','Không thể đánh dấu trùng với chính nó.',422);
   203	     const target=(await tx.query<{state:CandidateState}>('SELECT state FROM intake_candidates WHERE id=$1 AND project_id=$2',[input.duplicateOf,projectId])).rows[0];
   204	     if(!target) throw DENIED();
   205	     if(target.state==='duplicate') throw new AppError('INVALID_DUPLICATE_TARGET','Ứng viên đích đã là bản trùng của ứng viên khác.',422);
   206	     set.duplicateOf=input.duplicateOf;set.note=input.reason;detail.duplicateOf=input.duplicateOf;detail.reason=input.reason;break;
   207	    }
   208	    case 'dismiss': set.note=input.reason;detail.reason=input.reason;break;
   209	    case 'reopen': set.classification=null;set.duplicateOf=null;set.missing=[];set.note=input.reason;detail.reason=input.reason;break;
   210	    case 'link_ticket': set.ticketRef=input.ticketRef;detail.ticketRef=input.ticketRef;break;
   211	   }
   212	   const upd=await tx.query(
   213	    `UPDATE intake_candidates SET state=$3,classification=$4,duplicate_of=$5,missing_fields=$6::jsonb,note=$7,ticket_ref=$8,decided_by=$9,version=version+1,updated_at=now()
   214	     WHERE id=$1 AND version=$2 RETURNING id`,
   215	    [candidateId,input.expectedVersion,next,set.classification,set.duplicateOf,JSON.stringify(set.missing),set.note,set.ticketRef,p.id]);
   216	   if(!upd.rows.length) throw new AppError('REVISION_CONFLICT','Ứng viên đã thay đổi; tải lại rồi thao tác lại.',409);
   217	   const kind={confirm:'candidate.confirmed',need_info:'candidate.needs_info',mark_duplicate:'candidate.marked_duplicate',dismiss:'candidate.dismissed',reopen:'candidate.reopened',link_ticket:'candidate.ticket_linked'}[input.kind];
   218	   await tx.query(
   219	    `INSERT INTO intake_events(tenant_id,project_id,entity_type,entity_id,actor_id,actor_kind,kind,request_id,trace_id,payload) VALUES($1,$2,'intake_candidate',$3,$4,'user',$5,$6,$7,$8)`,
   220	    [p.tenantId,projectId,candidateId,p.id,kind,requestId,row.trace_id,JSON.stringify({stateBefore:row.state,stateAfter:next,versionBefore:row.version,versionAfter:row.version+1,...detail})]);
   221	   return {candidateId,state:next,version:row.version+1};
   222	   });
   223	   return loadCard(tx,projectId,done.candidateId,this.excerptChats);
   224	  });
   225	 }
