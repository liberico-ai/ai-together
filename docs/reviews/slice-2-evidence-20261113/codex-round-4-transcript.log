   129	 async list(p:Principal,raw:unknown):Promise<{items:CandidateCard[];total:number}> {
   130	  if(!p||p.role==='bot') throw DENIED();
   131	  const q=listSchema.parse(raw);
   132	  readable(p,q.projectId);
