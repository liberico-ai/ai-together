   391	     AND pg_catalog.pg_has_role(session_user, 'libetech_runtime', 'MEMBER') AND pg_catalog.pg_has_role(session_user, 'libetech_intake', 'MEMBER') THEN
   392	    RAISE EXCEPTION 'Outbox state change: the login can act as both libetech_runtime and libetech_intake, so its actor cannot be proven';
   393	  END IF;
