   826	def intake_hook(profile_home, /, *args, **kwargs):
   827	    """Observe one gateway message. Always None: never blocks, rewrites or reroutes dispatch, never raises into the
   828	    gateway, and logs fixed codes only (no text, chat id or name). `profile_home` is positional-only, so a gateway
   829	    keyword named `home` (or anything else) cannot collide with it.
   830	    Bounded work: intake.json first (missing or malformed: nothing else happens); a chat outside its "chats" stops
   831	    before download, spool or POST; then at most HOOK_REPLAYS spooled events and one live POST, each with HOOK_TIMEOUT."""
   832	    payload = None
   833	    try:
   834	        config = _intake_config(profile_home)
   835	        if not config["hookEnabled"]:
   836	            return None
   837	        event = kwargs["event"] if "event" in kwargs else (args[0] if args else None)
   838	        payload = intake_event(event, chats=config["chats"])
   839	        if payload is None:
   840	            return None
   841	        raw = getattr(event, "attachment", None)
   842	        if raw is not None:
   843	            # WIRING-STEP VERIFICATION ITEM: the download stays inline in the gateway's dispatch path, up to
   844	            # MAX_ATTACHMENT_BYTES, with whatever timeout the gateway's download_attachment() has. Check that it is safe
   845	            # there (thread, timeout, side effects) before "hookEnabled" is set on a real gateway.
   846	            payload["attachment"] = store_attachment(profile_home, raw, getattr(event, "download_attachment", None))
   847	        result = submit_event(profile_home, fit_event(payload), Spool(profile_home),
   848	                              timeout=HOOK_TIMEOUT, replays=HOOK_REPLAYS)
   849	        # A dead-lettered or lost message was already logged by Spool.bury with its fixed code.
   850	        if result.get("spooled"):
   851	            LOG.warning("libetech intake: %s", "INTAKE_SPOOLED")
   852	        elif not result.get("ok") and "error" in result:
   853	            LOG.warning("libetech intake: %s", result["error"])
   854	    except Exception as error:
   855	        LOG.warning("libetech intake: %s", safe_error(error)["error"])
   856	        if payload is not None:
   857	            # R3-8: the message was ours (allowed chat) but could not be built or submitted: keep its pointers only.
   858	            try:
   859	                Spool(profile_home).bury(_pointer_record(payload, error), attempts=0, reason="INTAKE_BUILD_FAILED")
   860	            except Exception:  # bury never raises; this guard only keeps that promise towards the gateway
   861	                LOG.warning("libetech intake: %s %s", "INTAKE_LOST", "INTAKE_BUILD_FAILED")
