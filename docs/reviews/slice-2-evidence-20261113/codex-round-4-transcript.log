   397	    kind := 'user'; who := nullif(pg_catalog.current_setting('app.person_id', true), '')::uuid;
   398	  ELSIF invoker = 'libetech_intake' THEN
   399	    kind := 'intake_service'; who := nullif(pg_catalog.current_setting('app.intake_principal_id', true), '')::uuid;
   400	  ELSE
   401	    RAISE EXCEPTION 'Role % may not change an outbox state', coalesce(recorded, invoker);
   402	  END IF;
   403	  IF recorded IS DISTINCT FROM invoker THEN RAISE EXCEPTION 'Outbox state change: the invoking role could not be established'; END IF;
