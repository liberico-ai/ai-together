   259	      WHERE kind='access_change' AND subject_user_id=$1 AND state IN ('pending','approved')
   260	        AND (expires_at<=now() OR subject_account_version<>$2) RETURNING id`,[user.id,user.version])).rows.map(row=>row.id);
   261	    const open=(await tx.query<{id:string}>(`SELECT id FROM identity.account_approvals
   262	      WHERE kind='access_change' AND subject_user_id=$1 AND state IN ('pending','approved')`,[user.id])).rows[0];
