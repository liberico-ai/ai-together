    41	export type Envelope={event_id:string;event_type:string;version:'v1';source:'libetech-ai-os';timestamp:string;tenant_id:string;trace_id:string;correlation_id:string;causation_id:string|null;payload:{template:string;params:Record<string,string>}};
    42	export type Delivery={outboxId:string;attemptNo:number;leaseToken:string;audience:'group'|'dm';chatId:string;topicId:string;replyToMessageId:string|null;envelope:Envelope};
    43	
    44	type Row={id:string;tenant_id:string;project_id:string|null;state:OutboxState;attempt_no:number;version:number;audience:'group'|'dm';recipient_user_id:string|null;
    45	 target_chat_id:string;target_topic_id:string;reply_to_message_id:string|null;event_id:string;event_type:string;event_version:string;source:string;occurred_at:string|Date;
    46	 trace_id:string;correlation_id:string;causation_id:string|null;template:string;payload:{params?:Record<string,string>};lease_token:string|null};
    47	const COLS='id,tenant_id,project_id,state,attempt_no,version,audience,recipient_user_id,target_chat_id,target_topic_id,reply_to_message_id,event_id,event_type,event_version,source,occurred_at,trace_id,correlation_id,causation_id,template,payload,lease_token';
    48	
    49	export type OutboxSetColumn='attempt_no'|'lease_token'|'lease_expires_at'|'delivered_at'|'telegram_message_id'|'last_error_code'|'failure_owner_id';
    50	export type OutboxMove={set?:Partial<Record<OutboxSetColumn,string|number|null>>;nextAttemptInSeconds?:number;leaseExpiresInSeconds?:number};
    51	// The actor is not passed: the database derives it from the invoking role and the transaction context (app.intake_principal_id / app.person_id).
    52	export type OutboxCtx={requestId:string};
    53	
    54	/** Sole writer of outbox_messages.state: validates the move with outboxTransition, then sets the signal and request id for the database,
    55	 * which writes the one outbox_state_events row itself (AFTER UPDATE trigger). Typed values only; every value is a bound parameter. */
    56	export async function applyOutboxSignal(tx:Queryable,row:Pick<Row,'id'|'tenant_id'|'project_id'|'state'|'attempt_no'|'version'|'trace_id'>,signal:OutboxSignal,ctx:OutboxCtx,move:OutboxMove={}):Promise<OutboxState> {
    57	 const next=outboxTransition(row.state,signal,row.attempt_no);
    58	 await tx.query("SELECT set_config('app.outbox_signal',$1,true), set_config('app.request_id',$2,true)",[signal,ctx.requestId]);
    59	 const params:unknown[]=[row.id,row.state,next,row.version];
    60	 const parts=['state=$3','version=version+1','updated_at=now()'];
    61	 for(const [k,v] of Object.entries(move.set??{})) {params.push(v);parts.push(`${k}=$${params.length}`);}
    62	 if(move.nextAttemptInSeconds!==undefined) {params.push(move.nextAttemptInSeconds);parts.push(`next_attempt_at=now() + make_interval(secs => $${params.length}::double precision)`);}
    63	 if(move.leaseExpiresInSeconds!==undefined) {params.push(move.leaseExpiresInSeconds);parts.push(`lease_expires_at=now() + make_interval(secs => $${params.length}::double precision)`);}
    64	 const r=await tx.query(`UPDATE outbox_messages SET ${parts.join(',')} WHERE id=$1 AND state=$2 AND version=$4 RETURNING id`,params);
    65	 if(!r.rows.length) throw new AppError('OUTBOX_CONFLICT','Tin đã được xử lý ở nơi khác; thử lại.',409);
    66	 return next;
    67	}
