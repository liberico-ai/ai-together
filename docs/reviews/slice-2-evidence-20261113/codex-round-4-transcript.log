   267	      (tenant_id,kind,subject_user_id,subject_account_version,previous_grants,proposer_id,grants,reason)
   268	      VALUES($1,'access_change',$2,$3,$4,$5,$6,$7) RETURNING id`,[p.tenantId,user.id,user.version,
   269	      JSON.stringify(before),p.id,JSON.stringify(grants),reason])).rows[0];
   270	    for(const seat of seats) await tx.query(`INSERT INTO identity.account_approval_voters
   271	      (approval_id,tenant_id,seat,user_id) VALUES($1,$2,$3,$4)`,[proposal.id,p.tenantId,seat.seat,seat.user_id]);
   272	    await this.notify(tx,this.identity,proposal.id,seats,traceId);
   273	    await this.audit(tx,p,user.id,'access_change_proposed',
